---
// A ginger cat curled up asleep, drawn as an SVG group for the Landscape.
// The origin is the middle of where the cat meets the ground.
type Props = {
  x: number;
  y: number;
  scale?: number;
};

const { x, y, scale = 1 } = Astro.props;

const grass = [-44, -40, -4, 2, 24, 31, 36];
---

<g transform={`translate(${x} ${y}) scale(${scale})`}>
  <ellipse class="fill-inkwell/15" cx="2" cy="0" rx="36" ry="4"></ellipse>

  <g class="cat-breathe">
    <ellipse class="fill-warm-walnut" cx="4" cy="-13" rx="28" ry="13"></ellipse>
    <circle class="fill-warm-walnut" cx="18" cy="-14" r="12"></circle>

    <g
      class="fill-none stroke-inkwell/25"
      stroke-width="2"
      stroke-linecap="round"
    >
      <path d="M0-25q2 5 0 9"></path>
      <path d="M8-26q2 5 0 9"></path>
      <path d="M16-25q2 5 0 8"></path>
      <path d="M24-22q2 4 0 7"></path>
    </g>
  </g>

  <path class="fill-warm-walnut" d="M-28-16-30-28-20-20Z"></path>
  <path class="fill-warm-walnut" d="M-18-19-13-30-10-18Z"></path>
  <path class="fill-dusk-rose" d="M-27-18-28.5-25-22.5-20Z"></path>
  <path class="fill-dusk-rose" d="M-16-20-13-26-11.5-19Z"></path>
  <circle class="fill-warm-walnut" cx="-20" cy="-11" r="10"></circle>

  <g class="fill-none stroke-inkwell" stroke-width="1.2" stroke-linecap="round">
    <path d="M-26-12q2 2 4 0"></path>
    <path d="M-18-13q2 2 4 0"></path>
  </g>
  <circle class="fill-dusk-rose" cx="-21" cy="-8" r="1.2"></circle>

  <ellipse class="fill-cream-soda" cx="-10" cy="-2.5" rx="5" ry="2.5"></ellipse>
  <path
    class="fill-none stroke-warm-walnut"
    d="M31-6C40 2 20 5-6 2.5-14 2-19 1-22-1"
    stroke-width="6"
    stroke-linecap="round"
  ></path>

  <g
    class="fill-none stroke-sage-dark"
    stroke-width="1.5"
    stroke-linecap="round"
  >
    {grass.map((bladeX) => (
      <path d={`M${bladeX} 1q1-5 3-8`} />
    ))}
  </g>

  <g class="font-handwritten fill-ash dark:fill-parchment">
    <text class="cat-zzz" x="-30" y="-36" font-size="9">
      z
    </text>
    <text class="cat-zzz" x="-24" y="-44" font-size="11" style="--delay: -1s">
      z
    </text>
    <text class="cat-zzz" x="-16" y="-54" font-size="13" style="--delay: -2s">
      z
    </text>
  </g>
</g>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .cat-breathe {
      transform-box: fill-box;
      transform-origin: bottom center;
      animation: breathe 4s ease-in-out infinite;
    }

    .cat-zzz {
      animation: zzz 3s ease-in-out var(--delay, 0s) infinite;
    }
  }

  @keyframes breathe {
    50% {
      transform: scaleY(1.06);
    }
  }

  @keyframes zzz {
    0%,
    100% {
      opacity: 0.2;
    }
    50% {
      opacity: 1;
    }
  }
</style>
