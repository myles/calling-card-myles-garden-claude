---
import GardenGate from "@/components/GardenGate.astro";
import SleepingCat from "@/components/SleepingCat.astro";

// A painted backdrop: sky, sun (or moon and stars), clouds, rolling hills with
// round trees, a garden gate, wildflowers, a sleeping cat and drifting motes
// that become fireflies after dark.

// Deterministic pseudo-random numbers, so every build renders the same scene.
const random = (() => {
  let seed = 7;
  return () => {
    seed = (seed * 16807) % 2147483647;
    return (seed - 1) / 2147483646;
  };
})();

const trees = [
  { x: 210, y: 214, size: 1.1 },
  { x: 250, y: 220, size: 0.8 },
  { x: 1040, y: 196, size: 1.3 },
  { x: 1090, y: 204, size: 0.9 },
  { x: 1300, y: 214, size: 0.7 },
];

const wildflowers = Array.from({ length: 70 }, () => ({
  x: random() * 1440,
  y: 272 + random() * 46,
  r: 1.5 + random() * 2,
  tone: random() > 0.4 ? "fill-dusk-rose" : "fill-honey",
}));

const stars = Array.from({ length: 60 }, () => ({
  left: `${random() * 100}%`,
  top: `${random() * 55}%`,
  size: `${1 + random() * 1.5}px`,
  delay: `${-random() * 6}s`,
}));

const motes = Array.from({ length: 22 }, () => ({
  left: `${random() * 100}%`,
  top: `${20 + random() * 70}%`,
  size: `${3 + random() * 4}px`,
  duration: `${10 + random() * 12}s`,
  delay: `${-random() * 20}s`,
}));
---

<div
  class="pointer-events-none absolute inset-0 overflow-hidden"
  aria-hidden="true"
>
  <div class="absolute inset-0 bg-linear-to-b from-sky-wash via-sage-wash to-cream-soda dark:from-midnight-soil dark:via-inkwell dark:to-inkwell"></div>

  <div class="hidden dark:block">
    {stars.map(({ left, top, size, delay }) => (
      <span
        class="star absolute rounded-full bg-parchment"
        style={{ left, top, width: size, height: size, "--delay": delay }}
      />
    ))}
  </div>

  <div class="absolute top-[8%] right-[12%] size-40 rounded-full bg-honey opacity-70 blur-2xl dark:size-24 dark:bg-parchment dark:opacity-25"></div>
  <div class="absolute top-[11%] right-[15%] size-20 rounded-full bg-honey/90 dark:size-12 dark:bg-parchment/80"></div>

  <svg
    class="cloud absolute top-[14%] -left-10 w-72 opacity-90 dark:hidden"
    viewBox="0 0 200 80"
  >
    <g class="fill-chalk">
      <circle cx="50" cy="50" r="28"></circle>
      <circle cx="90" cy="36" r="34"></circle>
      <circle cx="135" cy="48" r="26"></circle>
      <rect x="30" y="50" width="130" height="28" rx="14"></rect>
    </g>
  </svg>
  <svg
    class="cloud cloud-slow absolute top-[28%] left-[55%] w-52 opacity-70 dark:hidden"
    viewBox="0 0 200 80"
  >
    <g class="fill-chalk">
      <circle cx="60" cy="48" r="24"></circle>
      <circle cx="100" cy="38" r="30"></circle>
      <circle cx="140" cy="50" r="22"></circle>
      <rect x="40" y="50" width="120" height="24" rx="12"></rect>
    </g>
  </svg>

  <svg
    class="absolute inset-x-0 bottom-0 h-[45vh] min-h-64 w-full dark:brightness-[0.35]"
    viewBox="0 0 1440 320"
    preserveAspectRatio="xMidYMax slice"
  >
    <path
      class="fill-sage opacity-50"
      d="M0 180C200 120 380 150 560 130S900 90 1100 120 1340 140 1440 110V320H0Z"
    ></path>
    <path
      class="fill-sage"
      d="M0 230C180 190 360 200 540 215S860 170 1080 195 1320 220 1440 200V320H0Z"
    ></path>

    {trees.map(({ x, y, size }) => (
      <g transform={`translate(${x} ${y}) scale(${size})`}>
        <rect class="fill-warm-walnut" x="-3" y="-20" width="6" height="22" />
        <circle class="fill-sage-dark" cx="0" cy="-36" r="22" />
        <circle class="fill-sage-dark" cx="-14" cy="-26" r="14" />
        <circle class="fill-sage-dark" cx="14" cy="-26" r="14" />
        <circle class="fill-sage opacity-40" cx="-6" cy="-44" r="9" />
      </g>
    ))}

    <GardenGate x={630} y={209} scale={1.1} angle={-4} />

    <path
      class="fill-sage-dark"
      d="M0 280C240 250 420 265 640 270S1000 240 1220 260 1400 275 1440 270V320H0Z"
    ></path>

    {wildflowers.map(({ x, y, r, tone }) => (
      <circle class={tone} cx={x} cy={y} r={r} />
    ))}

    <SleepingCat x={795} y={268} scale={1.4} />
  </svg>

  {motes.map(({ left, top, size, duration, delay }) => (
    <span
      class="mote absolute rounded-full bg-honey/80 shadow-[0_0_6px_1px] shadow-honey/60 dark:bg-honey dark:shadow-[0_0_12px_4px] dark:shadow-honey/70"
      style={{
        left,
        top,
        width: size,
        height: size,
        "--duration": duration,
        "--delay": delay,
      }}
    />
  ))}
</div>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .cloud {
      animation: drift 90s linear infinite alternate;
    }

    .cloud-slow {
      animation-duration: 140s;
      animation-direction: alternate-reverse;
    }

    .star {
      animation: twinkle 6s ease-in-out var(--delay) infinite;
    }

    .mote {
      animation: float var(--duration) ease-in-out var(--delay) infinite;
    }
  }

  @keyframes drift {
    to {
      transform: translateX(30vw);
    }
  }

  @keyframes twinkle {
    50% {
      opacity: 0.3;
    }
  }

  @keyframes float {
    0%,
    100% {
      transform: translate(0, 0);
      opacity: 0;
    }
    20%,
    80% {
      opacity: 1;
    }
    50% {
      transform: translate(24px, -60px);
    }
  }
</style>
