---
import card from "@/data/card";
import Layout from "@/layouts/Layout.astro";
import { toDisplayUrl } from "@myles-garden/utils";
---

<Layout siteTitle={card.name} siteDescription={card.tagline}>
  <main class="grid min-h-dvh place-items-center bg-parchment p-4 font-sans text-inkwell sm:p-8 dark:bg-midnight-soil dark:text-parchment">
    <article class="h-card relative w-full max-w-xl overflow-hidden rounded-sm bg-chalk shadow-[0_1px_2px_rgb(0_0_0/0.06),0_12px_32px_-12px_rgb(0_0_0/0.25)] sm:aspect-[1.75] dark:bg-inkwell">
      <div
        class="absolute inset-y-0 left-0 w-2 bg-sage-dark"
        aria-hidden="true"
      ></div>

      <div class="flex h-full flex-col justify-between gap-8 p-8 pl-10 sm:p-10 sm:pl-12">
        <header>
          <p class="font-handwritten text-lg text-ash dark:text-sage">
            {card.greeting}
          </p>
          <h1 class="p-name mt-1 font-serif text-4xl font-semibold tracking-tight text-sage-dark sm:text-5xl dark:text-sage">
            <a class="u-url u-uid" href={card.url} rel="me">
              {card.name}
            </a>
          </h1>
          <p class="p-note mt-3 text-ash dark:text-mist">{card.tagline}</p>
        </header>

        <footer class="flex flex-col gap-4 text-sm sm:flex-row sm:items-end sm:justify-between">
          <ul class="space-y-1">
            <li>
              <a
                class="u-email underline-offset-4 hover:text-sage-dark hover:underline dark:hover:text-sage"
                href={`mailto:${card.email}`}
                rel="me"
              >
                {card.email}
              </a>
            </li>
            <li>
              <a
                class="underline-offset-4 hover:text-sage-dark hover:underline dark:hover:text-sage"
                href={card.url}
              >
                {toDisplayUrl(card.url)}
              </a>
            </li>
            {card.links.map(({ label, href, rel }) => (
              <li>
                <a
                  class="underline-offset-4 hover:text-sage-dark hover:underline dark:hover:text-sage"
                  href={href}
                  rel={rel}
                >
                  {label}
                </a>
              </li>
            ))}
          </ul>

          <div class="flex flex-col gap-1 sm:items-end">
            <p class="p-locality text-ash dark:text-mist">{card.location}</p>
            <a
              class="font-handwritten text-sage-dark underline-offset-4 hover:underline dark:text-sage"
              href="/contact.vcf"
              download
            >
              save my contact →
            </a>
          </div>
        </footer>
      </div>
    </article>
  </main>
</Layout>
